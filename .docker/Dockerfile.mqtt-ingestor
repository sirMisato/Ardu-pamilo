FROM node:24-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json tsconfig.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/workers/mqtt-ingestor/package.json apps/workers/mqtt-ingestor/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm ci

FROM deps AS build

COPY packages/shared packages/shared
COPY apps/workers/mqtt-ingestor apps/workers/mqtt-ingestor

RUN npm run build -w @pamilo/shared && npm run build -w @pamilo/mqtt-ingestor
RUN npm prune --omit=dev

FROM node:24-alpine AS runtime

ENV NODE_ENV=production

WORKDIR /app

COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/shared/package.json packages/shared/package.json
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/workers/mqtt-ingestor/package.json apps/workers/mqtt-ingestor/package.json
COPY --from=build /app/apps/workers/mqtt-ingestor/dist apps/workers/mqtt-ingestor/dist

USER node

CMD ["node", "apps/workers/mqtt-ingestor/dist/index.js"]
