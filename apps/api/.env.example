NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

# AI recommendation provider. Keep API keys out of git and set them in local/production env only.
# The Sumopod gateway can route OpenAI gpt-5-nano and Tencent hy3 with the same OpenAI-compatible API shape.
# Keep AI_RECOMMENDATION_BASE_URL on https://ai.sumopod.com for this app.
# Options: sumopod (default), openai, tencent, custom.
AI_RECOMMENDATION_PROVIDER=sumopod
AI_RECOMMENDATION_BASE_URL=https://ai.sumopod.com
AI_RECOMMENDATION_MODEL=gpt-5-nano
AI_RECOMMENDATION_API_KEY=
AI_RECOMMENDATION_OPENAI_API_KEY=
AI_RECOMMENDATION_TENCENT_API_KEY=
AI_RECOMMENDATION_MAX_TOKENS=1600
AI_RECOMMENDATION_TEMPERATURE=0.35
AI_RECOMMENDATION_TIMEOUT_MS=90000
# Tencent Hy3 via Sumopod gateway example:
# AI_RECOMMENDATION_PROVIDER=sumopod
# AI_RECOMMENDATION_BASE_URL=https://ai.sumopod.com
# AI_RECOMMENDATION_MODEL=hy3

# Use a strong value locally. Do not commit real production secrets.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=8h

# Store only a bcrypt hash here. Generate locally with:
# node -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('your-local-password', 12))"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD_HASH=

# Remote MySQL is configured via env only. Do not connect to production DB in local tests.
DATABASE_URL=mysql://pamilo_user:replace-me@127.0.0.1:3306/pamilo_saas
DATABASE_SSL=false

# Optional local demo tenant seed.
DEMO_TENANT_ENABLED=false
DEMO_TENANT_ID=demo-tenant
DEMO_TENANT_NAME=PAMILO Demo Farm
DEMO_TENANT_EMAIL=tenant@sedayafarm.local
DEMO_TENANT_PASSWORD=
# When true, seed:demo deletes tenant app data and leaves only the demo login tenant.
DEMO_TENANT_RESET_DATA=false

# MQTT ingestion is opt-in for local development.
MQTT_INGEST_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=pamilo-api-local
MQTT_TELEMETRY_TOPIC=pamilo/v1/tenants/+/devices/+/telemetry

# Web Push notifications for phone/browser background alerts.
# Generate a pair with:
# node -e "const webpush=require('web-push'); console.log(webpush.generateVAPIDKeys())"
WEB_PUSH_CONTACT=mailto:admin@pamilo.local
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
