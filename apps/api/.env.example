NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173

# Use a strong value locally. Do not commit real production secrets.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=8h

# Store only a bcrypt hash here. Generate locally with:
# node -e "import bcrypt from 'bcryptjs'; console.log(await bcrypt.hash('your-local-password', 12))"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD_HASH=

# Remote MySQL is configured via env only. Do not connect to production DB in local tests.
DATABASE_URL=mysql://pamilo_user:replace-me@127.0.0.1:3306/pamilo_saas
DATABASE_SSL=false

# MQTT ingestion is opt-in for local development.
MQTT_INGEST_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=pamilo-api-local
MQTT_TELEMETRY_TOPIC=pamilo/v1/tenants/+/devices/+/telemetry
