PAMILO_API_IMAGE=ghcr.io/example-owner/ardu-pamilo-api:replace-with-release-tag
PAMILO_WEB_IMAGE=ghcr.io/example-owner/ardu-pamilo-web:replace-with-release-tag
PAMILO_MQTT_INGESTOR_IMAGE=ghcr.io/example-owner/ardu-pamilo-mqtt-ingestor:replace-with-release-tag

PAMILO_WEB_PORT=8080
PAMILO_EMQX_MQTTS_PORT=8883
PAMILO_EMQX_DASHBOARD_PORT=18083
API_TRUSTED_ORIGINS=https://sedayafarm.keycloud.id
API_BODY_LIMIT_BYTES=262144
LOG_LEVEL=info

EMQX_IMAGE=emqx/emqx:5.8.8
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=replace-with-secret
MQTT_CLIENT_ID=pamilo-production-ingestor
MQTT_SERVICE_USERNAME=pamilo-ingestor
MQTT_SERVICE_PASSWORD=replace-with-secret

PAMILO_DEVICE_PLOT_MAP={}
PAMILO_MQTT_DEDUP_TTL_SECONDS=604800
BMKG_BASE_URL=https://api.bmkg.go.id
VICTORIA_METRICS_RETENTION_PERIOD=12

PAMILO_MYSQL_MODE=not_configured_until_tls_decision
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TLS_REJECT_UNAUTHORIZED=true

